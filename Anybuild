load("//anybuild/tools:node.bzl", "node_build", "node_config", "node_serve")

config = node_config(
    schema = 1,
    commands = {"start": "node server/index.mjs"},
    node_package_manager = "pnpm",
    node_server = "express",
    node_version = "24",
    pnpm_version = "11.25.0",
)

build = node_build(config)
node_serve(config, build, name = "ledgerai")
